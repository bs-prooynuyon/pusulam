rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }

    function isMember(gid) { return signedIn() && exists(docPath('groupMembers', gid + '_' + uid())); }
    function isOwner(gid) { return signedIn() && get(docPath('groups', gid)).data.ownerId == uid(); }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /classes/{classId} {
      allow read: if signedIn() && resource.data.teacherId == uid();
      allow create: if signedIn() && request.resource.data.teacherId == uid()
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }
    match /classCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == uid()
        && getAfter(docPath('classes', request.resource.data.classId)).data.teacherId == uid();
      allow delete: if signedIn() && resource.data.teacherId == uid();
    }
    match /members/{memberId} {
      // Henüz var olmayan belgeyi okumak ("zaten üye miyim?" kontrolü) resource == null ile izinli olmalı; yoksa katılma reddedilir.
      allow get: if signedIn() && resource == null;
      allow get: if signedIn() && resource.data.teacherId == uid();
      allow get: if signedIn() && resource.data.studentId == uid();
      allow list: if signedIn() && resource.data.teacherId == uid();
      allow list: if signedIn() && resource.data.studentId == uid();
      allow create: if signedIn()
        && request.resource.data.studentId == uid()
        && memberId == request.resource.data.classId + '_' + uid()
        && get(docPath('classCodes', request.resource.data.code)).data.classId == request.resource.data.classId
        && get(docPath('classCodes', request.resource.data.code)).data.teacherId == request.resource.data.teacherId;
      allow delete: if signedIn() && (resource.data.studentId == uid() || resource.data.teacherId == uid());

      match /messages/{messageId} {
        allow read: if signedIn() && (get(docPath('members', memberId)).data.teacherId == uid() || get(docPath('members', memberId)).data.studentId == uid());
        allow create: if signedIn() && request.resource.data.senderId == uid()
          && (get(docPath('members', memberId)).data.teacherId == uid() || get(docPath('members', memberId)).data.studentId == uid())
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'body', 'kind', 'createdAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 1000;
        allow delete: if signedIn() && (resource.data.senderId == uid() || get(docPath('members', memberId)).data.teacherId == uid());
      }
      match /programs/{programId} {
        allow read: if signedIn() && (get(docPath('members', memberId)).data.teacherId == uid() || get(docPath('members', memberId)).data.studentId == uid());
        allow create: if signedIn() && request.resource.data.teacherId == uid()
          && get(docPath('members', memberId)).data.teacherId == uid()
          && request.resource.data.studentId == get(docPath('members', memberId)).data.studentId
          && request.resource.data.lessons is list && request.resource.data.lessons.size() <= 60;
        allow update: if signedIn() && get(docPath('members', memberId)).data.studentId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saved']);
        allow delete: if signedIn() && (get(docPath('members', memberId)).data.teacherId == uid() || get(docPath('members', memberId)).data.studentId == uid());
      }
    }
    match /invites/{inviteId} {
      allow read: if signedIn() && (resource.data.teacherId == uid()
        || ('targetUid' in resource.data && resource.data.targetUid == uid())
        || (request.auth.token.email != null && resource.data.target == request.auth.token.email.lower()));
      allow create, update: if signedIn() && request.resource.data.teacherId == uid()
        && request.resource.data.target is string && request.resource.data.target.size() <= 120
        && get(docPath('classes', request.resource.data.classId)).data.teacherId == uid();
      allow delete: if signedIn() && (resource.data.teacherId == uid()
        || ('targetUid' in resource.data && resource.data.targetUid == uid())
        || (request.auth.token.email != null && resource.data.target == request.auth.token.email.lower()));
    }

    // ----- Kullanıcı adı ve arkadaşlık -----
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid() && name.matches('[a-z0-9_]{3,20}');
      allow delete: if signedIn() && resource.data.uid == uid();
    }
    match /profiles/{userId} {
      allow get: if signedIn();
      allow create, update: if signedIn() && uid() == userId
        && (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.matches('[a-z0-9_]{3,20}')))
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 40);
      allow delete: if signedIn() && uid() == userId;
    }
    match /friendRequests/{rid} {
      allow get: if signedIn() && resource == null;
      allow read: if signedIn() && (resource.data.fromUid == uid() || resource.data.toUid == uid());
      allow create: if signedIn() && request.resource.data.fromUid == uid()
        && request.resource.data.toUid is string && request.resource.data.toUid != uid()
        && rid == request.resource.data.fromUid + '_' + request.resource.data.toUid;
      allow delete: if signedIn() && (resource.data.fromUid == uid() || resource.data.toUid == uid());
    }
    match /rooms/{roomId} {
      function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
      function addedUid() { return request.resource.data.uids.toSet().difference(resource.data.uids.toSet()).toList()[0]; }
      function inRoom() { return signedIn() && uid() in get(docPath('rooms', roomId)).data.uids; }

      allow read: if signedIn() && uid() in resource.data.uids;
      // Sınıf odası: önce yalnızca kurucuyla açılır; kapasite 4, 6 veya 8 öğrenci masası.
      allow create: if signedIn() && request.resource.data.hostUid == uid()
        && request.resource.data.uids.size() == 1 && request.resource.data.uids[0] == uid()
        && request.resource.data.capacity in [4, 6, 8]
        && request.resource.data.allowTeacher is bool;
      // Üye yalnızca durumu (açık/kapalı) değiştirebilir.
      allow update: if signedIn() && uid() in resource.data.uids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // Kurucu, arkadaşı olan birini tek seferde bir kişi ekleyebilir (kapasite + öğretmen için 1 yer).
      allow update: if signedIn() && uid() == resource.data.hostUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uids'])
        && request.resource.data.uids.size() == resource.data.uids.size() + 1
        && request.resource.data.uids.size() <= resource.data.capacity + 1
        && request.resource.data.uids.hasAll(resource.data.uids)
        && exists(docPath('friendships', pairId(uid(), addedUid())));
      allow delete: if signedIn() && uid() in resource.data.uids;
      match /presence/{pid} {
        allow read: if inRoom();
        allow create, update: if inRoom() && pid == uid();
        allow delete: if inRoom();
      }
      match /photos/{pid} {
        allow read: if inRoom();
        allow create, update: if inRoom() && pid == uid()
          && request.resource.data.photo is string && request.resource.data.photo.size() < 400000;
        allow delete: if inRoom();
      }
    }
    match /friendships/{fid} {
      allow get: if signedIn() && resource == null;
      allow read: if signedIn() && uid() in resource.data.uids;
      allow create: if signedIn() && request.resource.data.uids.size() == 2
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && fid == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
        && uid() in request.resource.data.uids
        && (
          (get(docPath('friendRequests', request.resource.data.uids[0] + '_' + request.resource.data.uids[1])).data.toUid == uid())
          || (get(docPath('friendRequests', request.resource.data.uids[1] + '_' + request.resource.data.uids[0])).data.toUid == uid())
        );
      allow delete: if signedIn() && uid() in resource.data.uids;
    }
    match /requests/{requestId} {
      allow read: if signedIn() && (resource.data.teacherId == uid() || resource.data.studentId == uid());
      allow create: if signedIn() && request.resource.data.teacherId == uid()
        && request.resource.data.status == 'pending'
        && exists(docPath('members', request.resource.data.classId + '_' + request.resource.data.studentId))
        && get(docPath('members', request.resource.data.classId + '_' + request.resource.data.studentId)).data.teacherId == uid();
      allow update: if signedIn() && resource.data.studentId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'report'])
        && request.resource.data.status in ['approved', 'declined'];
      allow delete: if signedIn() && (resource.data.studentId == uid() || resource.data.teacherId == uid());
    }

    match /groups/{groupId} {
      allow get: if signedIn() && (groupId.matches('school_.*') || isMember(groupId) || isOwner(groupId));
      allow create: if signedIn() && request.resource.data.name is string && request.resource.data.name.size() <= 80 && (
        (request.resource.data.ownerId == uid() && request.resource.data.kind in ['class', 'student', 'dm'])
        || (request.resource.data.ownerId == null && request.resource.data.kind == 'school' && groupId.matches('school_.*')));
      allow delete: if isOwner(groupId);

      match /messages/{messageId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.senderId == uid()
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'body', 'createdAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 1000;
        // Herkes yalnızca kendi mesajını siler. Sınıf grubunda ayrıca grubu kuran öğretmen herkesinkini silebilir.
        allow delete: if signedIn() && (resource.data.senderId == uid()
          || (isOwner(groupId) && get(docPath('groups', groupId)).data.kind == 'class'));
      }

      match /tasks/{taskId} {
        allow read: if isMember(groupId) || isOwner(groupId);
        allow create: if isOwner(groupId) && request.resource.data.teacherId == uid()
          && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100;
        allow delete: if isOwner(groupId);
        match /done/{doneUid} {
          allow get: if signedIn() && (doneUid == uid() || isOwner(groupId));
          allow list: if isOwner(groupId);
          allow create, update, delete: if signedIn() && doneUid == uid() && isMember(groupId);
        }
      }

      match /reports/{reportId} {
        allow create: if isMember(groupId) && request.resource.data.reporterId == uid();
        allow read: if signedIn() && (isOwner(groupId) || resource.data.reporterId == uid());
        allow delete: if isOwner(groupId);
      }
    }
    match /groupCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == uid()
        && getAfter(docPath('groups', request.resource.data.groupId)).data.ownerId == uid();
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }
    match /groupMembers/{memberId} {
      // resource == null: "zaten üye miyim?" kontrolü henüz var olmayan belgeyi okur; izin verilmezse gruba katılma reddedilir.
      allow get: if signedIn() && resource == null;
      allow get: if signedIn() && resource.data.userId == uid();
      allow get: if signedIn() && isMember(resource.data.groupId);
      allow list: if signedIn() && resource.data.userId == uid();
      allow list: if signedIn() && isMember(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && memberId == request.resource.data.groupId + '_' + uid()
        && (
          getAfter(docPath('groups', request.resource.data.groupId)).data.ownerId == uid()
          || (request.resource.data.groupId.matches('school_.*') && getAfter(docPath('groups', request.resource.data.groupId)).data.kind == 'school')
          || (request.resource.data.code is string
              && get(docPath('groupCodes', request.resource.data.code)).data.groupId == request.resource.data.groupId));
      // Üye yalnızca kendi kaydındaki "role" alanını güncelleyebilir (grupta öğretmen/öğrenci etiketi için).
      allow update: if signedIn() && resource.data.userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['teacher', 'student'];
      allow delete: if signedIn() && (resource.data.userId == uid() || isOwner(resource.data.groupId));
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid()
        && request.resource.data.reason is string
        && request.resource.data.body is string && request.resource.data.body.size() <= 500;
      allow read, update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn() && request.resource.data.userId == uid()
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 5 && request.resource.data.body.size() <= 2000;
      allow read, delete: if signedIn() && resource.data.userId == uid();
    }
  }
}
